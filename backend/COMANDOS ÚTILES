# Iniciar proyecto desde cero
npm init -y
npm install express mongoose bcryptjs jsonwebtoken cors helmet morgan cookie-parser dotenv express-validator
npm install -D typescript ts-node nodemon @types/node @types/express @types/bcryptjs @types/jsonwebtoken @types/cors @types/morgan @types/cookie-parser

# Inicializar TypeScript
npx tsc --init

# Instalar MongoDB con Docker
docker-compose up -d

# Ver logs de MongoDB
docker logs -f lab_reservation_mongodb

# Acceder a MongoDB shell
docker exec -it lab_reservation_mongodb mongosh

# Detener servicios Docker
docker-compose down

# Ver base de datos (Mongo Express)
# Abrir en navegador: http://localhost:8081
